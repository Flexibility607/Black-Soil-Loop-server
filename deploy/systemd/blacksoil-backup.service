[Unit]
Description=Encrypted Black Soil Loop PostgreSQL backup
After=postgresql.service

[Service]
Type=oneshot
User=blacksoil
Group=blacksoil
EnvironmentFile=/etc/black-soil-loop/backend.env
ExecStart=/srv/black-soil-loop/current/deploy/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/black-soil-loop
