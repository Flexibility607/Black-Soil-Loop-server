[Unit]
Description=Verify latest encrypted Black Soil Loop backup by restoring it
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/black-soil-loop/backend.env
ExecStart=/srv/black-soil-loop/current/deploy/restore-verify.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/black-soil-loop /var/lib/postgresql
