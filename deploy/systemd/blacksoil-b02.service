[Unit]
Description=Black Soil Loop B02 mobile fulfillment API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=blacksoil
Group=blacksoil
WorkingDirectory=/srv/black-soil-loop/current
EnvironmentFile=/etc/black-soil-loop/backend.env
Environment=SERVICE_ROLE=b02
ExecStart=/srv/black-soil-loop/current/.venv/bin/uvicorn app.b02.main:app --host 127.0.0.1 --port 8102 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/black-soil-loop

[Install]
WantedBy=multi-user.target
